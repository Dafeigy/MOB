# Single-user login (exactly six digits). Use a unique value in production.
APP_PIN=482913

# Generate an independent random value for every production app.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Cloudflare D1 REST API credentials (server-side only; never add NEXT_PUBLIC_)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_D1_DATABASE_ID=your-database-id
CLOUDFLARE_D1_API_TOKEN=your-api-token
